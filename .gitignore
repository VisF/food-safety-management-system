# ============================================================
# VARIABLES DE ENTORNO Y CREDENCIALES
# ============================================================

.env
.env.*
!.env.example
!.env.dist

/config/.env
/config/.env.*
!/config/.env.example
!/config/.env.dist

# ============================================================
# DEPENDENCIAS Y ENTORNOS LOCALES
# ============================================================

/vendor/
/node_modules/
.venv/
venv/
env/

# ============================================================
# LOGS Y ARCHIVOS TEMPORALES
# ============================================================

/logs/*
!/logs/.gitkeep

*.log
*.tmp
*.temp
*.bak
*.old
*.swp
*.swo
*~

# ============================================================
# ARCHIVOS SUBIDOS POR USUARIOS
# ============================================================

/uploads/*
!/uploads/.gitkeep

# ============================================================
# RESULTADOS DE AUDITORÍAS
# ============================================================

/tools/path-audit/*-resultados.json
/tools/path-audit/*-resultados.txt
/tools/path-audit/reporte-*.json
/tools/path-audit/.venv/
/tools/path-audit/node_modules/
/tools/path-audit/package.json
/tools/path-audit/package-lock.json
/tools/path-audit/audit-before.json
/tools/path-audit/audit-v*.json

# ============================================================
# COMPILACIONES, CACHÉ Y COBERTURA
# ============================================================

/build/
/dist/
/target/
/coverage/
/cache/
/tmp/
/temp/

.phpunit.result.cache
.php-cs-fixer.cache
.phpstan/

# ============================================================
# BASES DE DATOS LOCALES Y COPIAS DE SEGURIDAD
# ============================================================

*.sqlite
*.sqlite3
*.db-journal
*.sql.gz
*.dump

# ============================================================
# IDEs Y EDITORES
# ============================================================

.vscode/
.idea/
*.iml
*.code-workspace

# ============================================================
# SISTEMA OPERATIVO
# ============================================================


.DS_Store
Thumbs.db
desktop.ini
